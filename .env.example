# =============================================================================
# SSTI_labs_E 环境变量样例
#
# 用法：复制为 .env 后按需修改。docker compose 会自动读取同目录的 .env。
#       .env 已被 .gitignore 忽略，不会进版本库。
# =============================================================================

# ------------------------------------------------------------------ flag 注入
# 优先级：GZCTF_FLAG > DASFLAG > FLAG > STATIC_FLAG
#
# 本地自测：什么都不设，各靶场用各自的 STATIC_FLAG 默认值。
# CTF 平台：平台会注入 GZCTF_FLAG（GZCTF）或 DASFLAG（DASCTF），
#           此时下面四行请全部留空，避免覆盖平台的动态 flag。
GZCTF_FLAG=
DASFLAG=
FLAG=

# 全局兜底：设了它，所有靶场用的是**同一个** flag（仅本地调试方便，勿用于比赛）
# STATIC_FLAG=flag{local_debug}

# 每个靶场的独立兜底（不设则用镜像里的默认值）
# STATIC_FLAG_JINJA_WAF=flag{jinja_waf_fenjing}
# STATIC_FLAG_JINJA_CHAIN=flag{jinja_chain}
# STATIC_FLAG_MAKO_CHAIN=flag{mako_chain}
# STATIC_FLAG_TORNADO_CHAIN=flag{tornado_chain}
# STATIC_FLAG_JINJA_SANDBOX=flag{jinja_sandbox_escape}
# STATIC_FLAG_BLIND=flag{blind_ssti}
# STATIC_FLAG_MEMSHELL=flag{flask_memshell}
# STATIC_FLAG_FREEMARKER=flag{freemarker_memshell}

# ------------------------------------------------------------------ 管理令牌
# 设置后可用 POST /api/admin/reset + 请求头 X-Reset-Token 重写 /flag。
# 留空则该接口一律拒绝（403）。
RESET_TOKEN=

# ------------------------------------------------------------------ 端口
# 改动前请确认宿主机端口未被占用。默认 8091–8098。
JINJA_WAF_PORT=8091
JINJA_CHAIN_PORT=8092
MAKO_CHAIN_PORT=8093
TORNADO_CHAIN_PORT=8094
JINJA_SANDBOX_PORT=8095
BLIND_SSTI_PORT=8096
FLASK_MEMSHELL_PORT=8097
FREEMARKER_MEMSHELL_PORT=8098

# ------------------------------------------------------------------ 其它
# 单次渲染输出的最大字符数（防止 __subclasses__() 之类撑爆响应）
SSTI_MAX_OUTPUT_CHARS=262144

# 无回显靶场的写文件回显目录（容器内路径，HTTP 挂在 /echo/）
SSTI_ECHO_DIR=/app/echo

# Java 靶场 JVM 参数
JAVA_OPTS=-Xms64m -Xmx256m -Dfile.encoding=UTF-8

# 统一前端镜像名（各靶场 Dockerfile 的 named stage 引用它）
FRONTEND_IMAGE=ssti-frontend:local
