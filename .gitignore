# =============================================================================
# SSTI_labs_E —— .gitignore
# =============================================================================

# ------------------------------------------------------------------ 密钥/flag
# 绝对不要把 flag 提交进仓库：flag 一律由 entrypoint 从环境变量写入 /flag
.env
.env.*
!.env.example
flag.txt
/flag

# ------------------------------------------------------------------ Node
node_modules/
frontend/build/
frontend/node_modules/
npm-debug.log*
yarn-error.log*

# 旧的 CRA 前端残留（若本地还留着老版本）
/build/
/coverage/

# ------------------------------------------------------------------ Python
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/
.pytest_cache/
.mypy_cache/
.ruff_cache/

# ------------------------------------------------------------------ Java
labs/08-freemarker-memshell/target/
*.class
!labs/08-freemarker-memshell/**/*.class.b64

# ------------------------------------------------------------------ 编辑器 / 系统
.idea/
.vscode/
*.iml
*.swp
*~
.DS_Store
Thumbs.db

# ------------------------------------------------------------------ 运行时产物
*.log
logs/
# 探索期的临时脚本（正式脚本请放进 scripts/ 或 tests/）
tests/_*.py
/tmp/
