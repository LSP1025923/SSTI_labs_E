<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <parent>
    <groupId>org.springframework.boot</groupId>
    <artifactId>spring-boot-starter-parent</artifactId>
    <version>2.7.18</version>
    <relativePath/>
  </parent>

  <groupId>com.lab</groupId>
  <artifactId>themepreview</artifactId>
  <version>1.0.0</version>
  <name>theme-preview</name>
  <description>Java SSTI lab: FreeMarker / Thymeleaf -&gt; Tomcat in-memory webshell (no egress)</description>

  <properties>
    <java.version>8</java.version>
    <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
    <!--
      故意降级 FreeMarker 到 2.3.28（Spring Boot 2.7.18 默认带 2.3.31）：
        * 2.3.30+ 官方把 freemarker.template.utility.Execute 判为 RCE 危险类，
          移除了它的 INSTANCE 静态实例并收紧了 ?new 的默认白名单；
        * 2.3.29 又顺手删掉了 freemarker.template.ObjectConstructor 这个老的内置类。
      2.3.28 是同时还有 Execute 和 ObjectConstructor 的最后版本之一，
      也正是当年这批「老 Java 应用」真实带在身上的版本，最贴近事故现场。
      注意：真正造成 RCE 的是 Configuration#setNewBuiltinClassResolver(UNRESTRICTED_RESOLVER)
      这个配置错误，而不是版本本身 —— 见 README「为什么这个靶场能用 ?new」。
    -->
    <freemarker.version>2.3.28</freemarker.version>
  </properties>

  <dependencies>
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-web</artifactId>
    </dependency>
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-thymeleaf</artifactId>
    </dependency>
    <dependency>
      <groupId>org.freemarker</groupId>
      <artifactId>freemarker</artifactId>
      <version>${freemarker.version}</version>
    </dependency>
  </dependencies>

  <build>
    <plugins>
      <plugin>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-maven-plugin</artifactId>
        <configuration>
          <mainClass>com.lab.themepreview.ThemePreviewApplication</mainClass>
        </configuration>
      </plugin>
    </plugins>
  </build>
</project>
